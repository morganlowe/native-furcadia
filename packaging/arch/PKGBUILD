# Maintainer: Morgan Lowe <https://github.com/morganlowe/native-furcadia>
pkgname=furcadia-native
pkgver=2.2.6
pkgrel=1
pkgdesc="Native Furcadia client (GUI and CLI)"
arch=('x86_64')
url="https://github.com/morganlowe/native-furcadia"
license=('CC-BY-NC-SA-4.0')
options=('!debug')
depends=('glibc' 'libglvnd' 'libx11' 'libxcb' 'libxkbcommon' 'curl' 'bzip2' 'unzip' 'openssl')
makedepends=('cargo' 'openssl' 'pkgconf')
source=("$pkgname-$pkgver.tar.gz::https://github.com/morganlowe/native-furcadia/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "$srcdir/native-furcadia-$pkgver"
  export CARGO_HOME="$srcdir/.cargo"
  # Arch's hardened linker uses -nodefaultlibs. OpenSSL's Rust crate needs
  # the system libraries explicitly linked on this target.
  export OPENSSL_NO_VENDOR=1
  cargo build --release --locked --bins
}

package() {
  cd "$srcdir/native-furcadia-$pkgver"
  install -Dm755 "target/release/furc-gui" "$pkgdir/usr/bin/furc-gui"
  install -Dm755 "target/release/furc-cli" "$pkgdir/usr/bin/furc-cli"
  install -Dm644 "packaging/linux/furcadia-native.desktop" "$pkgdir/usr/share/applications/furcadia-native.desktop"
  install -Dm644 "packaging/linux/furcadia-native.png" "$pkgdir/usr/share/icons/hicolor/256x256/apps/furcadia-native.png"
  install -Dm644 "LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
